# Symbol Normalization Configuration
# Maps various symbol formats to canonical symbols
# Format: "canonical_symbol": ["variant1", "variant2", ...]

# ============================================================
# STOCKS WITH SPECIAL CHARACTERS
# ============================================================

# Berkshire Hathaway
BRK-B: ["BRK.B", "BRK B", "BRK/B"]
BRK-A: ["BRK.A", "BRK A", "BRK/A"]

# Brown-Forman
BF-A: ["BF.A", "BF A", "BF/A"]
BF-B: ["BF.B", "BF B", "BF/B"]

# ============================================================
# INTERNATIONAL STOCKS (Exchange suffixes)
# ============================================================

# London Stock Exchange (.L)
VOD.L: ["VOD", "VOD LN", "VOD:LSE"]
BP.L: ["BP", "BP LN", "BP:LSE"]
HSBA.L: ["HSBA", "HSBA LN", "HSBC LN"]

# Swiss Exchange (.SW)
NESN.SW: ["NESN", "NESN SW", "NESN:SWX"]
NOVN.SW: ["NOVN", "NOVN SW", "NOVN:SWX"]

# Toronto Stock Exchange (.TO)
TD.TO: ["TD", "TD TO", "TD:TSE"]
RY.TO: ["RY", "RY TO", "RY:TSE"]

# ============================================================
# CURRENCY PAIRS (FX)
# ============================================================

# Major pairs
EURUSD: ["EUR/USD", "EUR-USD", "EURUSD=X", "EUR.USD"]
USDJPY: ["USD/JPY", "USD-JPY", "JPY=X", "USD.JPY"]
GBPUSD: ["GBP/USD", "GBP-USD", "GBPUSD=X", "GBP.USD"]
USDCHF: ["USD/CHF", "USD-CHF", "CHF=X", "USD.CHF"]

# Asian currencies
USDTHB: ["USD/THB", "USD-THB", "THB=X", "USD.THB"]
USDHKD: ["USD/HKD", "USD-HKD", "HKD=X", "USD.HKD"]
USDSGD: ["USD/SGD", "USD-SGD", "SGD=X", "USD.SGD"]

# Cross pairs
EURTHB: ["EUR/THB", "EUR-THB", "EURTHB=X", "EUR.THB"]
EURGBP: ["EUR/GBP", "EUR-GBP", "EURGBP=X", "EUR.GBP"]
EURJPY: ["EUR/JPY", "EUR-JPY", "EURJPY=X", "EUR.JPY"]

