  default_portfolio_name: "Cryptocurrency"
  wallet_type: "hardware wallet"

HardwareWallet3:
  description: "Hardware wallet #3 (closed example)"
  account_id: 7
  account_name: "Hardware Wallet 3"
  default_portfolio_id: 5
