# Symbol Mapping Configuration
# Maps trading symbols to their market data providers and currencies
#
# This file provides DEFAULT mappings that are used as fallback when
# a symbol is not found in the database SymbolMapping table.
#
# The SymbolMapping table is the PRIMARY source and gets auto-populated:
# - New crypto symbols → Auto-mapped to USD via CoinMarketCap/yfinance
# - New IBKR securities → Auto-mapped using currency from IBKR Flex Query
# - Manual overrides → Can be added via database or this config
#
# Priority: Database SymbolMapping > This Config File > Hardcoded Defaults
#
# 🎯 BEST PRACTICE FOR EUROPEAN ETFs:
# -----------------------------------
# 1. ADD symbol to this file BEFORE first purchase
# 2. Restart container to reload config
# 3. Then execute your buy order
# 4. Price sync will find the symbol in this file and auto-populate database
#
# Why? European securities need exchange suffix (e.g., VWCE.DE for XETRA)
# Without this, yfinance won't find the ticker and price sync will fail.
#
# WHEN TO ADD ENTRIES:
# - European securities needing exchange suffix (e.g., VWCE.DE, VUAA.AS)
# - Special cases with non-standard providers
# - Symbols where auto-detection fails
#
# WHEN NOT TO ADD:
# - US securities (auto-detected correctly, no suffix needed)
# - Crypto (auto-detected correctly, USD default)
# - Anything that works with defaults

# ============================================================================
# MANUAL OVERRIDES (When auto-detection needs help)
# ============================================================================

# European ETFs (XETRA - Frankfurt)
# These trade in EUR and need explicit yfinance exchange suffix
#
# 🔧 HOW TO ADD A NEW EUROPEAN ETF:
# 1. Add entry here with correct exchange suffix (.DE, .AS, .L, etc.)
# 2. Restart container: docker compose restart nicefolio_gui
# 3. Execute your buy order through your broker
# 4. Daily sync will find this entry and create database mapping

# Example European ETF on XETRA (Frankfurt)
VEUR:
  yfinance_symbol: "VEUR.DE"
  currency: "EUR"
  exchange: "XETRA"
  description: "Example European ETF (Vanguard FTSE Developed Europe)"
  provider: "yfinance"

# Example European ETF on Milan Exchange
VUSD:
  yfinance_symbol: "VUSD.MI"
  currency: "EUR"
  exchange: "Milan"
  description: "Example European ETF (Vanguard S&P 500)"
  provider: "yfinance"

# Example sector ETF
TECH:
